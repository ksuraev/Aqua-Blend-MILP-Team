# Copy to .env and fill in the blanks. .env is gitignored; never commit real credentials.

# --- Supabase PostgreSQL connection (required) -------------------------------
# PGHOST/PGUSER/PGPASSWORD have no defaults in _connect(); the worker will not
# start without them.
PGHOST=aws-1-ap-northeast-2.pooler.supabase.com
PGUSER=postgres.<project-ref>
PGPASSWORD=

# Use the SESSION pooler port (5432), not the transaction pooler (6543).
# run_worker.execution_key_lock() relies on pg_advisory_lock, which is
# session-scoped; under transaction pooling the lock is not held for the
# duration of a solve and two workers can solve the same cache miss.
PGPORT=5432

# Defaults applied by _connect() when unset; listed here so they are visible.
PGDATABASE=postgres
PGSSLMODE=require

# --- MILP worker (optional) --------------------------------------------------
# Overrides the git-commit-derived model version that feeds execution_key, and
# therefore MILP result cache identity. Leave unset for local development so
# resolve_milp_model_version() can fingerprint the working tree. Set it only for
# deploys built without a .git directory, to a release tag or commit SHA.
# AQUABLEND_MILP_MODEL_VERSION=

# Queue poll interval in seconds (default 2.0, minimum 0.25).
# AQUABLEND_RUN_POLL_SECONDS=2.0

# Worker log level (default INFO).
# AQUABLEND_LOG_LEVEL=INFO
